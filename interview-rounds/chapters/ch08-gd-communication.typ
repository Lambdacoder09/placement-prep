]

#code(lang: "js", caption: "ctc.js — turn an offer letter into a monthly number. Teaching figures only.")[
```js
function slabTax(x) {                       // simplified ladder, shape only
  const slabs = [[400000, 0], [800000, 0.05], [1200000, 0.10],
                 [1600000, 0.15], [Infinity, 0.20]];
  let tax = 0, prev = 0;
  for (const [cap, rate] of slabs) {
    if (x > prev) tax += (Math.min(x, cap) - prev) * rate;
    prev = cap;
  }
  if (x <= 1200000) tax = 0;                // rebate band
  return tax * 1.04;                        // + 4% cess
}

function inHand(o) {
  const fixed = o.ctc - o.variable - o.joiningBonus - o.employerPF - o.gratuity - o.insurance;
  const basic = fixed * o.basicShare;
  const employeePF = basic * 0.12;          // your own PF cut, also out of fixed pay
  const tax = slabTax(fixed - employeePF - o.standardDeduction);
  const annual = fixed - employeePF - tax - o.profTax;
  return { fixed, employeePF, tax, monthly: annual / 12 };
}

const offerA = { name: 'Offer A', ctc: 900000, variable: 120000, joiningBonus: 50000,
  employerPF: 43200, gratuity: 17300, insurance: 12000, basicShare: 0.45,
  standardDeduction: 75000, profTax: 2400 };
const offerB = { name: 'Offer B', ctc: 780000, variable: 0, joiningBonus: 0,
  employerPF: 37440, gratuity: 15000, insurance: 10000, basicShare: 0.50,
  standardDeduction: 75000, profTax: 2400 };

for (const o of [offerA, offerB]) {
  const r = inHand(o);
  console.log('\n' + o.name + '  (headline CTC Rs ' + (o.ctc / 100000).toFixed(1) + ' LPA)');
  console.log('  fixed pay                 Rs', Math.round(r.fixed).toLocaleString('en-IN'));
  console.log('  variable, NOT guaranteed  Rs', o.variable.toLocaleString('en-IN'));
  console.log('  your PF cut               Rs', Math.round(r.employeePF).toLocaleString('en-IN'));
  console.log('  income tax + cess         Rs', Math.round(r.tax).toLocaleString('en-IN'));
  console.log('  TAKE HOME per month       Rs', Math.round(r.monthly).toLocaleString('en-IN'));
}
```
]
